{
  "name": "grok-hyper",
  "productName": "grok-hyper",
  "version": "0.1.0",
  "private": true,
  "description": "grok-hyper desktop shell: Electron window around hyper web",
  "author": "wu1w",
  "license": "Apache-2.0",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "console": "npm --prefix ../console install && npm --prefix ../console run build",
    "sidecars": "sh scripts/build-sidecars.sh",
    "prepare:resources": "node scripts/prepare.mjs",
    "dist": "npm run console && npm run sidecars && node scripts/prepare.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --mac dmg zip --arm64 --win zip --x64",
    "dist:mac": "npm run console && HYPER_SIDECAR_SKIP_WIN=1 npm run sidecars && node scripts/prepare.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --mac dmg zip --arm64",
    "dist:win": "npm run console && npm run sidecars && node scripts/prepare.mjs --require-win && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never --win zip --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.grokhyper.desktop",
    "productName": "grok-hyper",
    "copyright": "Apache-2.0",
    "asar": true,
    "files": [
      "main.mjs",
      "preload.cjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../console/dist",
        "to": "console"
      },
      {
        "from": "../../third_party/qwen-family",
        "to": "vendor"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Hyper 需要截取屏幕，以便 ComputerUse 看到桌面并点击。"
      },
      "extraResources": [
        {
          "from": "resources/mac",
          "to": "bin"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/win",
          "to": "bin"
        }
      ],
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "publish": null
  }
}
