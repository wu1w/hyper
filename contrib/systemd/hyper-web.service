# Headless Hyper on a home server. This is a fill-in template, not a drop-in.
#
# Prefer a **user** unit (no root, uses your ~/.grok-hyper):
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/hyper-web.service ~/.config/systemd/user/
#   # set ExecStart to `which hyper` (cargo install → %h/.cargo/bin/hyper)
#   # set WantedBy=default.target
#   systemctl --user daemon-reload
#   systemctl --user enable --now hyper-web
#
# System unit (runs as root unless you set User=):
#   sudo cp contrib/systemd/hyper-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hyper-web
# Do not enable this file unchanged: User= is commented out and
# ExecStart=/usr/local/bin/hyper is often the wrong path.
#
# Do not also run `hyper --channels` — this process already long-polls.

[Unit]
Description=Hyper web console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User=william
# WorkingDirectory=/home/william
ExecStart=/usr/local/bin/hyper web --no-open
# cargo install: ExecStart=%h/.cargo/bin/hyper web --no-open
# LAN console:   ExecStart=... web --bind 0.0.0.0:3848 --allow-lan --no-open
Restart=always
RestartSec=5
# EnvironmentFile=-%h/.grok-hyper/hyper.env

[Install]
WantedBy=multi-user.target
# user unit: WantedBy=default.target
